# Copia este archivo a .env SOLO para pruebas locales (NUNCA subas .env real a git).
# En Render, estas mismas variables se configuran en el Dashboard -> tu servicio -> Environment.

# API key de Anthropic (empieza con sk-ant-...). Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Secreto compartido inventado por ti (cualquier cadena larga y aleatoria).
# Tu index.html debe mandar este mismo valor en el header "X-Audit-Secret" de cada
# petición a /api/auditar. Sin esto, cualquiera con la URL de Render podría gastar tu
# cuota de la API de Claude.
AUDIT_SHARED_SECRET=

# Opcional: orígenes permitidos por CORS, separados por coma. Deja "*" si no estás
# seguro (igual queda protegido por AUDIT_SHARED_SECRET).
CORS_ALLOWED_ORIGINS=*
